# Neon (https://neon.tech) connection string — from your Neon project dashboard,
# "Connection Details" -> "psycopg2" / "pooled connection". Must include sslmode=require.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<your-neon-host>.neon.tech/<dbname>?sslmode=require
SIMILARITY_THRESHOLD=0.2975
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
RATE_LIMIT_IDENTIFY_PER_MINUTE=20
RATE_LIMIT_ENROLL_PER_MINUTE=10
LOG_LEVEL=INFO
